--Data Cleaning
--1.count blank/null values
select 
count(transaction_id),count(transaction_date),count(customer_id),count(gender),count(age),count(product_category),
count(quantity),count(price_per_unit),count(total_amount)
from retail_sales_db
where transaction_id is null or transaction_date is null or customer_id=''or
gender='' or age is null or product_category is null or quantity is null or 
price_per_unit is null or total_amount is null;
--------------------
SELECT
    COUNT(*) FILTER (WHERE transaction_id IS NULL) AS null_transaction_id,
    COUNT(*) FILTER (WHERE transaction_date IS NULL) AS null_date,
    COUNT(*) FILTER (WHERE customer_id IS NULL) AS null_customer_id,
    COUNT(*) FILTER (WHERE gender IS NULL) AS null_gender,
    COUNT(*) FILTER (WHERE age IS NULL) AS null_age,
    COUNT(*) FILTER (WHERE product_category IS NULL) AS null_category,
    COUNT(*) FILTER (WHERE quantity IS NULL) AS null_quantity,
    COUNT(*) FILTER (WHERE price_per_unit IS NULL) AS null_price,
    COUNT(*) FILTER (WHERE total_amount IS NULL) AS null_total
FROM retail_sales_db;

--2.distinct values
select 
count(distinct transaction_id),count(distinct transaction_date),count(distinct customer_id),count(distinct gender),count(distinct age),count(distinct product_category),
count(distinct quantity),count(distinct price_per_unit),count(distinct total_amount)
from retail_sales_db;
--3.check gender
select distinct gender
from retail_sales_db
where gender not IN ('Male', 'Female');
--4.check age <18 or age>100
select *
from retail_sales_db
where age < 18 or age >100;
--5.check product category
select distinct product_category
from retail_sales_db;
--6.
select *
from retail_sales_db
where quantity <0 or price_per_unit < 0 or total_amount <0;

--7.validate total_amount
select *
from retail_sales_db
where total_amount <>quantity*price_per_unit;

--8.check leading or trailing spaces
select *
from retail_sales_db
where customer_id <> trim(customer_id)
or gender <> trim(gender)
or product_category <> trim(product_category);
--9. Check date range
SELECT
    MIN(transaction_date),
    MAX(transaction_date)
FROM retail_sales_db;
--10. Check data type
SELECT data_type
FROM information_schema.columns
WHERE table_name = 'retail_sales_db'
AND column_name = 'transaction_date';
--11.Check category variations:
SELECT
    LOWER(TRIM(product_category)) AS cleaned_category,
    COUNT(DISTINCT product_category) AS variations
FROM retail_sales_db
GROUP BY LOWER(TRIM(product_category));
