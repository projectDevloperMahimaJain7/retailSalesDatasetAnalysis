--EDA
/*Mean
Median
Mode
Min
Max
Range
Standard Deviation
Q1 (25th Percentile)
Q3 (75th Percentile)
Interquartile Range (IQR)
Sample Size (N)*/
SELECT ROUND(AVG(total_amount),2) AS mean,
PERCENTILE_CONT (0.5) WITHIN GROUP (ORDER BY total_amount) as median,
MIN(total_amount)as min_revenue,
MAX(total_amount)as max_revenue,
ROUND(STDDEV(total_amount),2) AS std_mean,
PERCENTILE_CONT (0.25) WITHIN GROUP (ORDER BY total_amount) as q1_revenue,
PERCENTILE_CONT (0.75) WITHIN GROUP (ORDER BY total_amount) as q3_revenue,
PERCENTILE_CONT (0.75) WITHIN GROUP (ORDER BY total_amount) - PERCENTILE_CONT (0.25) WITHIN GROUP (ORDER BY total_amount) as iqr_revenue,
count(transaction_id) as sample_size
from retail_sales_db;

2.mom revenue & mom growth
SELECT
    TO_CHAR(transaction_date, 'YYYY-MM') AS month,
    SUM(total_amount) AS monthly_revenue,
    COUNT(transaction_id) AS txn_count,

    LAG(SUM(total_amount), 1) OVER (
        ORDER BY TO_CHAR(transaction_date, 'YYYY-MM')
    ) AS prev_revenue,

    ROUND(
        (
            SUM(total_amount) -
            LAG(SUM(total_amount), 1) OVER (
                ORDER BY TO_CHAR(transaction_date, 'YYYY-MM')
            )
        ) /
        NULLIF(
            LAG(SUM(total_amount), 1) OVER (
                ORDER BY TO_CHAR(transaction_date, 'YYYY-MM')
            ), 0
        ) * 100,
        2
    ) AS mom_growth_pct

FROM retail_sales_db
GROUP BY 1
ORDER BY 1;
--3.Product category by gender
SELECT
    product_category,

    SUM(CASE
        WHEN gender = 'Female' THEN total_amount
        ELSE 0
    END) AS female_revenue,

    SUM(CASE
        WHEN gender = 'Male' THEN total_amount
        ELSE 0
    END) AS male_revenue,

    SUM(total_amount) AS category_total_revenue,

    ROUND(
        SUM(total_amount) * 100 /
        SUM(SUM(total_amount)) OVER(),
        2
    ) AS share_category_revenue_pct

FROM retail_sales_db
GROUP BY product_category
ORDER BY share_category_revenue_pct DESC;
--4.Age bracket share revenue
select
case
when age between 18 and 24 then '18-24'
when age between 25 and 34 then '25-34'
when age between 35 and 49 then '35-49'
when age >=50 then '50+'
end
as age_bracket,
count(transaction_id) as txn_count,
sum(quantity) as units_sold,
sum(total_amount) as cohort_revenue,
ROUND(AVG(total_amount),2) as cohort_aov,
ROUND(sum(total_amount)/sum(sum(total_amount))over(),2) as share_revenue_pct
from retail_sales_db
group by 1
order by 1;
--5.customer segmentation
select 
customer_id,
count(transaction_id),
sum(total_amount) as total_amount_spend,
MIN(transaction_date) as first_order_date,
MAX(transaction_date) as last_order_date,
sum(quantity) as total_units,
dense_rank() over(order by sum(total_amount) desc) as spend_rank
from retail_sales_db
group by 1
order by 3 desc
limit 20;

--6.trend smoothening
select 
transaction_date,
sum(total_amount) as daily_revenue,
sum(sum(total_amount)) over(order by transaction_date rows between unbounded preceding and current row) as cumulative_revenue,
ROUND(AVG(SUM(total_amount)) OVER (ORDER BY transaction_date ROWS BETWEEN 29 PRECEDING AND CURRENT ROW), 2) AS rolling_30d_avg_revenue
from retail_sales_db
group by 1
order by 1;





